@model HtthDay03.Models.Product
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<h2 style="margin: 20px;">Chi tiết sản phẩm</h2>

<div class="row">
    <div class="col-md-5">
        <img src="@Model.Image" alt="@Model.Name" style="width: 100%; border: 1px solid #ddd; border-radius:4px;" />
    </div>

    <div class="col-md-7">
        <h3 style="font-weight: bold; margin-bottom: 15px;">Sản phẩm: @Model.Name</h3>
        <p style="font-size: 16px; margin-bottom: 15px;">
            Giá gốc: <span style="text-decoration: line-through; color: #888; margin-left: 15px;">@Model.Price.ToString("#,##0")</span>
            Giá mới: <span style="color: red; font-weight: bold; font-size: 18px;">@Model.salePrice.ToString("#,##0")</span>
        </p>

        <h4 style="font-weight: bold; margin-top: 15px;">Mô tả</h4>
        <p style="line-height: 1.6; text-align: justify;">@Model.Description</p>
        <p style="margin-top: 15px;"><strong>Trạng thái:</strong> @(Model.Status ? "Còn hàng" : "Hết hàng")</p>
             
             <p style="margin-top: 25px;">
                 <a asp-action="Index" class="btn btn-primary" style="background-color: #337ab7; color: white; padding: 10px 20px; border-radius: 4px; text-decoration: none;">Quay lại danh sách sản phẩm</a>
             </p>
    </div>
</div>

@{
    ViewData["Title"] = "Trang chủ";
}


<div class="card border-primary mb-4">
    <div class="card-header bg-primary text-white">
        Sản phẩm mới nhất
    </div>
    <div class="card-body">
        <div class="row">
            @for (int i = 0; i < 3; i++)
            {
                <div class="col-md-4 text-center mb-3">
                    <img src="~/image/anh.png" class="img-fluid mb-2" alt="Nồi cơm" />
                    <h6>Nồi cơm điện cao tần Nagakawa NAG0102</h6>
                </div>
            }
        </div>
    </div>
</div>


@await Component.InvokeAsync("HotProduct")


@{
    ViewData["Title"] = "ListProduct";
    var products = ViewData["list-product"] as List<HtthLesson3.Models.HtthProduct>;
    var product = ViewData["htthProduct"] as HtthLesson3.Models.HtthProduct;
}

<h1>@ViewBag.hello</h1>
<hr/>
<h2>Sản phẩm</h2>
<p>Mã: @product.productId</p>
<p>Tên: @product.productName</p>
<hr/>
@foreach (var item in products)
{
    <p>Mã: @item.productId - Ten: @item.productName</p>
    
}


